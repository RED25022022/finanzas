rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada persona ve solo su propio perfil (aquí guarda a qué hogar pertenece).
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Un hogar se crea con un solo miembro: quien lo crea.
    // Su pareja se une con el código: solo puede agregarse a sí misma, y hasta 2 miembros.
    // Nadie puede quitar miembros.
    match /hogares/{hid} {
      allow create: if request.auth != null
        && request.resource.data.miembros == [request.auth.uid];
      allow read: if request.auth != null && request.auth.uid in resource.data.miembros;
      allow update: if request.auth != null
        && request.auth.uid in request.resource.data.miembros
        && request.resource.data.miembros.size() <= 2
        && request.resource.data.miembros.hasAll(resource.data.miembros)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros']);
    }

    // Todos los datos del hogar (movimientos, cuotas, metas, ajustes) solo para sus miembros.
    match /hogares/{hid}/{documento=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/hogares/$(hid)).data.miembros;
    }
  }
}
